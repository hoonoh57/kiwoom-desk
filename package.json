{
  "name": "kiwoom-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "test:tick": "tsx --test tests/tickAggregation.test.ts",
    "test:indicators": "tsx --test tests/indicatorAddon.test.ts tests/indicatorOverlay.test.ts tests/jmaIndicator.test.ts tests/disparityIndicator.test.ts tests/indicatorIncrementalContract.test.ts tests/vwapIndicator.test.ts",
    "test:strategies": "tsx --test tests/strategyAddon.test.ts",
    "test:diagnostics": "tsx --test tests/chartDiagnostics.test.ts",
    "test:api": "tsx --test tests/KiwoomClient.test.ts",
    "test:watchlist": "tsx --test tests/watchlist.test.ts",
    "test:settings": "tsx --test tests/settings.test.ts",
    "test:autotrade": "tsx --test tests/autotrade.test.ts",
    "test:chart-window": "tsx --test tests/chartWindowPolicy.test.ts tests/dockWindowControls.test.ts",
    "test:audit": "tsx --test tests/workbenchAudit.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "dockview-core": "1.17.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lightweight-charts": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
